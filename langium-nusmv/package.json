{
  "name": "vscode-nusmv",
  "displayName": "NuSMV VSCode Extension",
  "description": "NuSMV extension for VSCode powered by Langium",
  "version": "0.9.6",
  "publisher": "LiamWalsh98",
  "license": "EPL-1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LiamWalsh98/vscode-nusmv.git",
    "directory": "langium-nusmv"
  },
  "type": "module",
  "engines": {
    "vscode": "^1.123.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:nusmv",
    "onCommand:nusmv.createTerminal",
    "onCommand:nusmv.runCurrent"
  ],
  "main": "./out/extension/main.js",
  "contributes": {
    "configuration": {
      "title": "NuSMV",
      "properties": {
        "nusmv.disableSemanticChecksOnLargeFiles": {
          "type": "boolean",
          "default": true,
          "description": "Disable NuSMV language-server semantic checks for files above the configured line threshold."
        },
        "nusmv.semanticChecksMaxLines": {
          "type": "number",
          "default": 10000,
          "minimum": 1,
          "description": "Maximum line count for NuSMV language-server semantic checks when large-file semantic checks are disabled."
        }
      }
    },
    "languages": [
      {
        "id": "nusmv",
        "aliases": [
          "NuSMV"
        ],
        "extensions": [
          ".smv"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "nusmv",
        "scopeName": "source.nusmv",
        "path": "./syntaxes/nusmv.tmLanguage.json"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "nusmv.runCurrent",
          "when": "editorLangId == nusmv"
        }
      ]
    },
    "commands": [
      {
        "command": "nusmv.createTerminal",
        "title": "NuSMV: New Interactive Shell"
      },
      {
        "command": "nusmv.runCurrent",
        "title": "NuSMV: Run Current Model"
      }
    ],
    "keybindings": [
      {
        "command": "nusmv.createTerminal",
        "key": "ctrl+i",
        "mac": "cmd+i"
      },
      {
        "command": "nusmv.runCurrent",
        "key": "ctrl+r",
        "mac": "cmd+r"
      }
    ]
  },
  "scripts": {
    "langium:generate": "langium generate",
    "build": "npm run langium:generate && tsc -p tsconfig.json",
    "test": "npm run build && node --test out/**/*.test.js",
    "watch": "tsc -w -p tsconfig.json",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "langium": "^4.2.0",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.90.0",
    "langium-cli": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
